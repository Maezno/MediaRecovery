<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>MediaRecovery Studio</ApplicationTitle>
    <RootNamespace>MediaRecovery</RootNamespace>
    <AssemblyName>MediaRecovery</AssemblyName>

    <!-- Icono de la aplicación -->
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>

    <!-- Metadatos de la v1.0.4 -->
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <Company>MediaRecovery Studio</Company>
    <Product>MediaRecovery Studio</Product>
    <Description>Suite profesional de recuperación forense de video ProRes, conversión optimizada y gestión de biblioteca.</Description>
    <Copyright>Copyright © 2026</Copyright>

    <!-- Configuración para publicación Single-File autónomo con librerías nativas WPF -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Incrustar icono para la ventana y paquete de herramientas -->
  <ItemGroup>
    <Resource Include="Resources\app_icon.ico" />
    <Resource Include="Resources\app_icon.png" />
    <EmbeddedResource Include="Resources\Tools\tools.zip" />
  </ItemGroup>

</Project>

