<Window x:Class="MediaRecovery.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MediaRecovery.ViewModels"
        xmlns:helpers="clr-namespace:MediaRecovery.Helpers"
        mc:Ignorable="d"
        Title="MediaRecovery Studio (.NET 10)"
        Icon="/Resources/app_icon.ico"
        Height="700" Width="980"
        MinHeight="480" MinWidth="560"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgPrimary}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Estilos locales reutilizables -->
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="FieldGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,18,6"/>
        </Style>
        <Style x:Key="LogBox" TargetType="Border">
            <Setter Property="Background" Value="#090D13"/>
            <Setter Property="BorderBrush" Value="#252D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style x:Key="Splitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ToolTip" Value="Arrastrar para redimensionar el registro"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header compacto con botón de actualización y banner -->
        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MediaRecovery Studio" FontSize="17" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                    <Border Background="#21262D" CornerRadius="4" Margin="10,0,0,0" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0 (.NET 10)" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Border>
                </StackPanel>

                <!-- Botón Buscar Actualizaciones en la esquina derecha -->
                <Button DockPanel.Dock="Right" 
                        Content="🔄 Buscar actualización" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Command="{Binding CheckUpdateCommand}" 
                        IsEnabled="{Binding IsCheckingUpdate, Converter={x:Null}}" 
                        FontSize="11" 
                        Padding="8,3" 
                        HorizontalAlignment="Right"
                        ToolTip="Comprobar si hay una versión más reciente en GitHub (maezno/MediaRecovery)"/>
            </DockPanel>

            <!-- Banner flotante de aviso de actualización disponible -->
            <Border Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVis}}" 
                    Background="#162235" 
                    BorderBrush="{StaticResource BrushAccent}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Margin="0,6,0,0" 
                    Padding="10,6">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" 
                            Content="✕" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Command="{Binding DismissUpdateCommand}" 
                            Padding="6,2" 
                            FontSize="11" 
                            Margin="6,0,0,0" 
                            VerticalAlignment="Center"/>
                    
                    <Button DockPanel.Dock="Right" 
                            Content="{Binding UpdateButtonText}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Background="#238636" 
                            BorderBrush="#2EA043" 
                            Command="{Binding DownloadUpdateCommand}" 
                            Visibility="{Binding UpdateButtonText, Converter={x:Null}}"
                            Padding="10,3" 
                            FontSize="11" 
                            FontWeight="SemiBold" 
                            Margin="6,0,0,0" 
                            VerticalAlignment="Center"/>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateNoticeText}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                        <ProgressBar Height="4" Value="{Binding UpdateDownloadProgress}" Maximum="100" Margin="0,4,0,0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource BrushSuccess}" Background="#21262D"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ═══════════ TAB 1: DESCARGAR DE YOUTUBE / WEB ═══════════ -->
            <TabItem Header="Descargar de YouTube / Web" DataContext="{Binding Downloader}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170" MinHeight="90"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Enlace del video (YouTube o URL compatible)" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Pegar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PasteUrlCommand}" MinWidth="70"/>
                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Carpeta de destino" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFolderCommand}"/>
                                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <CheckBox Content="Abrir carpeta al finalizar" IsChecked="{Binding OpenFolderOnComplete}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Formato y rango" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <RadioButton Content="Video (MP4)" IsChecked="{Binding IsVideo}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6" VerticalAlignment="Center"/>
                                        <RadioButton Content="Audio (MP3)" IsChecked="{Binding IsAudio}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6" VerticalAlignment="Center"/>
                                        <StackPanel Style="{StaticResource FieldGroup}" IsEnabled="{Binding IsAudio}">
                                            <TextBlock Text="Bitrate MP3:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedValue="{Binding Mp3Quality}" SelectedValuePath="Content" Width="90">
                                                <ComboBoxItem Content="128k"/>
                                                <ComboBoxItem Content="192k"/>
                                                <ComboBoxItem Content="256k"/>
                                                <ComboBoxItem Content="320k" IsSelected="True"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,6,0,0">
                                        <RadioButton Content="Video completo" IsChecked="{Binding DownloadFull}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6"/>
                                        <RadioButton Content="Solo un fragmento" IsChecked="{Binding DownloadCut}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6"/>
                                    </WrapPanel>
                                    <WrapPanel IsEnabled="{Binding DownloadCut}">
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Desde:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding StartH}" Width="36" TextAlignment="Center"/>
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                            <TextBox Text="{Binding StartM}" Width="36" TextAlignment="Center"/>
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                            <TextBox Text="{Binding StartS}" Width="36" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Hasta:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding EndH}" Width="36" TextAlignment="Center"/>
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                            <TextBox Text="{Binding EndM}" Width="36" TextAlignment="Center"/>
                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                            <TextBox Text="{Binding EndS}" Width="36" TextAlignment="Center"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Style="{StaticResource Splitter}"/>

                    <!-- Panel inferior fijo: acciones + progreso + log -->
                    <DockPanel Grid.Row="2">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="Iniciar Descarga" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartDownloadCommand}" MinWidth="140" Margin="0,0,8,4"/>
                            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,4"/>
                        </WrapPanel>
                        <ProgressBar DockPanel.Dock="Top" Height="6" Value="{Binding Progress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource LogBox}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:ScrollViewerExtensions.AutoScrollToEnd="True">
                                <TextBlock Text="{Binding LogOutput}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11.5" Foreground="#A5D6FF" LineHeight="18" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════ TAB 2: RECUPERACIÓN PRORES ═══════════ -->
            <TabItem Header="Recuperación ProRes" DataContext="{Binding Recovery}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="200" MinHeight="90"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">
                            <Border Style="{StaticResource CardPanel}" AllowDrop="True" DragOver="OnRecoveryFileDragOver" Drop="OnRecoveryFileDrop">
                                <StackPanel>
                                    <TextBlock Text="1. Archivo dañado / imagen raw (.mov, .raw, .img, .bin - Arrastrá aquí)" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFileCommand}"/>
                                        <TextBox Text="{Binding SourceFilePath, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" DragOver="OnRecoveryFileDragOver" Drop="OnRecoveryFileDrop" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <WrapPanel Margin="0,8,0,0">
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Buffer (MB):" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding BufferSizeMB}" Width="50" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Frame mín (bytes):" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding FrameMin}" Width="80" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Frame máx (bytes):" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding FrameMax}" Width="90" TextAlignment="Center"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="Iniciar Escaneo" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" MinWidth="140" Margin="0,0,8,4"/>
                                        <Button Content="Detener" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelScanCommand}" MinWidth="90" Margin="0,0,8,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="2. Reconstrucción QuickTime (.mov)" Style="{StaticResource SectionTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Guardar como..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseOutputCommand}"/>
                                        <TextBox Text="{Binding OutputMovPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <CheckBox Content="Incluir pista de audio LPCM (si está presente)" IsChecked="{Binding IncludeAudio}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,8"/>
                                    <Button Content="Reconstruir Contenedor MOV" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BuildMovCommand}" HorizontalAlignment="Left" MinWidth="200"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Style="{StaticResource Splitter}"/>

                    <DockPanel Grid.Row="2">
                        <ProgressBar DockPanel.Dock="Top" Height="6" Value="{Binding ScanProgress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushSuccess}"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsText}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding ScanStatus}" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <!-- Frames y log lado a lado -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="160"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="1.4*" MinWidth="160"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                                <ListView ItemsSource="{Binding DiscoveredFrames}" Background="Transparent" BorderThickness="0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding Offset}" Width="120"/>
                                            <GridViewColumn Header="Longitud" DisplayMemberBinding="{Binding Length}" Width="100"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>
                            <Border Grid.Column="2" Style="{StaticResource LogBox}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:ScrollViewerExtensions.AutoScrollToEnd="True">
                                    <TextBlock Text="{Binding LogOutput}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11.5" Foreground="#A5D6FF" LineHeight="18" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════ TAB 3: CONVERTIR VIDEOS & LOTES ═══════════ -->
            <TabItem Header="Convertir Videos &amp; Lotes" DataContext="{Binding Converter}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="140"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="160" MinHeight="90"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">

                            <!-- Origen: Individual / Lote como sub-pestañas -->
                            <Border Style="{StaticResource CardPanel}" Padding="8,4,8,10">
                                <TabControl Background="Transparent" SelectedIndex="{Binding SelectedSubTabIndex}">
                                    <TabItem Header="Archivo individual" FontSize="13" Padding="10,6">
                                        <StackPanel Margin="4,10,4,0" AllowDrop="True" DragOver="OnSingleFileDragOver" Drop="OnSingleFileDrop">
                                            <TextBlock Text="Origen (MP4, MOV, MKV, AVI, MXF, ProRes... Arrastrá aquí uno o varios)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseSourceFileCommand}"/>
                                                <TextBox Text="{Binding SourceFile, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" DragOver="OnSingleFileDragOver" Drop="OnSingleFileDrop" Margin="0,0,8,0"/>
                                            </DockPanel>

                                            <!-- Estado de comprobación de integridad -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding IsCheckingIntegrity, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Analizando integridad y contenedor del video..." FontStyle="Italic" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Alerta de archivo dañado / recomendación de reparación -->
                                            <Border Margin="0,0,0,8" 
                                                    Background="#261A1A" 
                                                    BorderBrush="#F85149" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="10,8"
                                                    Visibility="{Binding HasInputErrors, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding InputWarningTitle}" FontWeight="Bold" Foreground="#FFA198" FontSize="12"/>
                                                        <TextBlock Text="{Binding InputWarningMessage}" Foreground="{StaticResource BrushTextPrimary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" 
                                                            Content="🔧 Reparar archivo" 
                                                            Style="{StaticResource PrimaryButtonStyle}" 
                                                            Command="{Binding NavigateToRepairCommand}"
                                                            Background="#DA3633"
                                                            BorderBrush="#F85149"
                                                            VerticalAlignment="Center"
                                                            Padding="12,6"
                                                            FontWeight="SemiBold"
                                                            ToolTip="Abrir este archivo en la pestaña de Recuperación"/>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="Salida" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Content="Guardar como..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseOutputFileCommand}"/>
                                                <TextBox Text="{Binding OutputFile, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            </DockPanel>

                                            <!-- Fragmento (solo individual) -->
                                            <WrapPanel>
                                                <RadioButton Content="Video completo" IsChecked="{Binding ConvertFull}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6"/>
                                                <RadioButton Content="Solo un fragmento" IsChecked="{Binding ConvertCut}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,18,6"/>
                                            </WrapPanel>
                                            <WrapPanel IsEnabled="{Binding ConvertCut}">
                                                <StackPanel Style="{StaticResource FieldGroup}">
                                                    <TextBlock Text="Desde:" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Text="{Binding StartH}" Width="36" TextAlignment="Center"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                                    <TextBox Text="{Binding StartM}" Width="36" TextAlignment="Center"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                                    <TextBox Text="{Binding StartS}" Width="36" TextAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Style="{StaticResource FieldGroup}">
                                                    <TextBlock Text="Hasta:" Style="{StaticResource FieldLabel}"/>
                                                    <TextBox Text="{Binding EndH}" Width="36" TextAlignment="Center"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                                    <TextBox Text="{Binding EndM}" Width="36" TextAlignment="Center"/>
                                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="3,0"/>
                                                    <TextBox Text="{Binding EndS}" Width="36" TextAlignment="Center"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </TabItem>

                                    <TabItem Header="Procesamiento por lotes" FontSize="13" Padding="10,6">
                                        <StackPanel Margin="4,10,4,0" AllowDrop="True" DragOver="OnBatchFilesDragOver" Drop="OnBatchFilesDrop">
                                            <WrapPanel Margin="0,0,0,6">
                                                <Button Content="Agregar videos..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddBatchFilesCommand}" Margin="0,0,8,4"/>
                                                <Button Content="Quitar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveBatchItemCommand}" Margin="0,0,8,4"/>
                                                <Button Content="Limpiar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearBatchCommand}" Margin="0,0,8,4"/>
                                                <TextBlock Text="(Arrastrá archivos simples o múltiples aquí)" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,4" FontSize="11.5"/>
                                            </WrapPanel>
                                            <Border Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="130" Margin="0,0,0,8" AllowDrop="True" DragOver="OnBatchFilesDragOver" Drop="OnBatchFilesDrop">
                                                <ListView ItemsSource="{Binding BatchItems}" SelectedItem="{Binding SelectedBatchItem}" Background="Transparent" BorderThickness="0" AllowDrop="True" DragOver="OnBatchFilesDragOver" Drop="OnBatchFilesDrop">
                                                    <ListView.View>
                                                        <GridView>
                                                            <GridViewColumn Header="Archivo" DisplayMemberBinding="{Binding FileName}" Width="220"/>
                                                            <GridViewColumn Header="Progreso" Width="120">
                                                                <GridViewColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" Width="100" Foreground="{StaticResource BrushAccent}"/>
                                                                    </DataTemplate>
                                                                </GridViewColumn.CellTemplate>
                                                            </GridViewColumn>
                                                            <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding Status}" Width="110"/>
                                                            <GridViewColumn Header="Ruta" DisplayMemberBinding="{Binding FilePath}" Width="300"/>
                                                        </GridView>
                                                    </ListView.View>
                                                </ListView>
                                            </Border>
                                            <TextBlock Text="Carpeta destino (opcional; por defecto la misma del archivo)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseBatchFolderCommand}"/>
                                                <TextBox Text="{Binding BatchOutputFolder, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Border>

                            <!-- Ajustes de calidad compartidos -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Calidad y codificación (optimizado V5)" Style="{StaticResource SectionTitle}"/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Formato:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedValue="{Binding SelectedCodec}" SelectedValuePath="Content" Width="160">
                                                <ComboBoxItem Content="H.264 (MP4)" IsSelected="True"/>
                                                <ComboBoxItem Content="H.265 / HEVC (MP4)"/>
                                                <ComboBoxItem Content="ProRes 422 HQ (MOV)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Bitrate (Mb/s):" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding BitrateMbps}" Width="50" TextAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="GPU:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedValue="{Binding SelectedGpu}" SelectedValuePath="Content" Width="150">
                                                <ComboBoxItem Content="Auto (Recomendado)" IsSelected="True"/>
                                                <ComboBoxItem Content="Nvidia (NVENC V5)"/>
                                                <ComboBoxItem Content="AMD (AMF)"/>
                                                <ComboBoxItem Content="CPU (libx264)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Desentrelazado:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox SelectedValue="{Binding SelectedDeinterlace}" SelectedValuePath="Content" Width="330">
                                                <ComboBoxItem Content="🧠 Inteligente (detectar por archivo)" IsSelected="True"/>
                                                <ComboBoxItem Content="Desentrelazar -&gt; 50p (Recomendado ProRes / Doble de cuadros)"/>
                                                <ComboBoxItem Content="Desentrelazar -&gt; 25p (Recomendado Blackmagic)"/>
                                                <ComboBoxItem Content="Auto (Solo cuadros entrelazados)"/>
                                                <ComboBoxItem Content="Progresivo (No tocar el video)"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ScanTypeInfo}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    <CheckBox Content="Incluir audio (mezcla estéreo 320 kbps)" IsChecked="{Binding IncludeAudio}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Row="1" Style="{StaticResource Splitter}"/>

                    <!-- Panel inferior fijo -->
                    <DockPanel Grid.Row="2">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="Convertir archivo" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartSingleConvertCommand}" MinWidth="140" Margin="0,0,8,4"/>
                            <Button Content="Iniciar lote" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartBatchConvertCommand}" MinWidth="120" Margin="0,0,8,4"/>
                            <Button Content="Cancelar" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" MinWidth="90" Margin="0,0,8,4"/>
                            <Button Content="📂 Ir al archivo convertido" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Background="#238636" 
                                    BorderBrush="#2EA043" 
                                    Command="{Binding OpenOutputCommand}" 
                                    Visibility="{Binding HasLastOutput, Converter={StaticResource BoolToVis}}" 
                                    MinWidth="160" 
                                    Margin="8,0,8,4" 
                                    ToolTip="Abrir la ubicación del archivo o carpeta de salida en el Explorador"/>
                        </WrapPanel>
                        <ProgressBar DockPanel.Dock="Top" Height="6" Value="{Binding Progress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource LogBox}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" helpers:ScrollViewerExtensions.AutoScrollToEnd="True">
                                <TextBlock Text="{Binding LogOutput}" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11.5" Foreground="#A5D6FF" LineHeight="18" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ═══════════ TAB 4: BIBLIOTECA & HERRAMIENTAS ═══════════ -->
            <TabItem Header="Biblioteca &amp; Herramientas" DataContext="{Binding LibraryTools}">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selector de carpeta principal compartido -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,8" Padding="10,8" AllowDrop="True" DragOver="OnFolderADragOver" Drop="OnFolderADrop">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="Carpeta de origen a analizar (Arrastrá aquí una carpeta)" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <CheckBox DockPanel.Dock="Right" Content="Incluir subcarpetas (recursivo)" IsChecked="{Binding IsRecursive}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFolderACommand}"/>
                                <TextBox Text="{Binding FolderPathA, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" DragOver="OnFolderADragOver" Drop="OnFolderADrop" Margin="0,0,8,0"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sub-pestañas con las 4 herramientas especializadas -->
                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedToolIndex}" Background="Transparent">

                        <!-- ──────── 1. ANALIZADOR DE DISPOSITIVOS & PRENSA ──────── -->
                        <TabItem Header="📱 Analizador de Dispositivos (Prensa)" FontSize="12">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Barra de filtros y acciones -->
                                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="8,6" Margin="0,0,0,6">
                                    <WrapPanel VerticalAlignment="Center">
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Mes:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding MonthsList}" SelectedItem="{Binding SelectedMonth}" Width="110"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Año:" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding YearsList}" SelectedItem="{Binding SelectedYear}" Width="90"/>
                                        </StackPanel>
                                        <Button Content="▶ Analizar metadatos" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" Margin="0,0,8,4"/>
                                        <Button Content="⏹ Detener" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelScanCommand}" Margin="0,0,8,4"/>
                                        <Button Content="⬇ Resumen CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCsvSummaryCommand}" Margin="0,0,6,4"/>
                                        <Button Content="⬇ Detalle CSV" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCsvDetailCommand}" Margin="0,0,6,4"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Barra de progreso y métricas -->
                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar DockPanel.Dock="Top" Height="5" Value="{Binding ScanProgress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushAccent}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsText}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Contenido: Resumen Dispositivos y Detalle lado a lado -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380" MinWidth="240"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*" MinWidth="300"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Panel Izquierdo: Resumen de Modelos -->
                                    <Border Grid.Column="0" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="Dispositivos detectados (clic para filtrar)" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="4,0,0,6"/>
                                            <ListView ItemsSource="{Binding DeviceSummaries}" SelectedItem="{Binding SelectedDeviceSummary}" Background="Transparent" BorderThickness="0">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Dispositivo" DisplayMemberBinding="{Binding DeviceModel}" Width="160"/>
                                                        <GridViewColumn Header="Vert." DisplayMemberBinding="{Binding VerticalCount}" Width="45"/>
                                                        <GridViewColumn Header="Horiz." DisplayMemberBinding="{Binding HorizontalCount}" Width="45"/>
                                                        <GridViewColumn Header="Total" DisplayMemberBinding="{Binding TotalCount}" Width="45"/>
                                                        <GridViewColumn Header="% V" DisplayMemberBinding="{Binding PctVertical}" Width="45"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </Border>

                                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

                                    <!-- Panel Derecho: Videos filtrados -->
                                    <Border Grid.Column="2" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="📂 Abrir en Explorador" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding SelectedMetadataItem.FilePath}" Padding="8,3" FontSize="11"/>
                                                <TextBlock Text="Videos (Doble clic en fila para ubicar)" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ListView ItemsSource="{Binding FilteredVideosForSelectedDevice}" SelectedItem="{Binding SelectedMetadataItem}" Background="Transparent" BorderThickness="0">
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <EventSetter Event="MouseDoubleClick" Handler="OnMetadataItemDoubleClicked"/>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Archivo" DisplayMemberBinding="{Binding FileName}" Width="170"/>
                                                        <GridViewColumn Header="Orientación" DisplayMemberBinding="{Binding Orientation}" Width="80"/>
                                                        <GridViewColumn Header="Resolución" DisplayMemberBinding="{Binding Resolution}" Width="85"/>
                                                        <GridViewColumn Header="Duración" DisplayMemberBinding="{Binding DurationFormatted}" Width="70"/>
                                                        <GridViewColumn Header="Tamaño" DisplayMemberBinding="{Binding SizeFormatted}" Width="75"/>
                                                        <GridViewColumn Header="Carpeta" DisplayMemberBinding="{Binding Directory}" Width="260"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- ──────── 2. BUSCADOR DE VIDEOS ROTOS O DAÑADOS ──────── -->
                        <TabItem Header="⚠️ Videos Rotos o Dañados" FontSize="12">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="8,6" Margin="0,0,0,6">
                                    <WrapPanel VerticalAlignment="Center">
                                        <CheckBox Content="Prueba profunda de decodificación (ffmpeg probe)" IsChecked="{Binding DeepDecodeCheck}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Button Content="▶ Buscar videos rotos" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" Margin="0,0,8,0"/>
                                        <Button Content="⏹ Detener" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelScanCommand}" Margin="0,0,8,0"/>
                                    </WrapPanel>
                                </Border>

                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar DockPanel.Dock="Top" Height="5" Value="{Binding ScanProgress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushDanger}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsText}" Foreground="{StaticResource BrushDanger}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <Border Grid.Row="2" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button Content="📂 Abrir en Explorador" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding SelectedBrokenItem.FilePath}" Margin="0,0,8,0"/>
                                            <Button Content="🔧 Enviar a Reparación ProRes" Style="{StaticResource PrimaryButtonStyle}" Background="#D97706" BorderBrush="#F59F00" Command="{Binding SendToRepairCommand}" CommandParameter="{Binding SelectedBrokenItem.FilePath}" ToolTip="Abrir este video en la pestaña de Recuperación ProRes"/>
                                        </WrapPanel>
                                        <ListView ItemsSource="{Binding BrokenItems}" SelectedItem="{Binding SelectedBrokenItem}" Background="Transparent" BorderThickness="0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Archivo dañado" DisplayMemberBinding="{Binding FileName}" Width="200"/>
                                                    <GridViewColumn Header="Tamaño" DisplayMemberBinding="{Binding SizeFormatted}" Width="85"/>
                                                    <GridViewColumn Header="Diagnóstico / Razón del fallo" DisplayMemberBinding="{Binding ErrorReason}" Width="320"/>
                                                    <GridViewColumn Header="¿ProRes?" DisplayMemberBinding="{Binding IsProResCandidate}" Width="75"/>
                                                    <GridViewColumn Header="Carpeta" DisplayMemberBinding="{Binding Directory}" Width="320"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ──────── 3. BUSCADOR DE VIDEOS SIN COMPRESIÓN / PESADOS ──────── -->
                        <TabItem Header="📦 Videos Sin Compresión / Pesados" FontSize="12">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="8,6" Margin="0,0,0,6">
                                    <WrapPanel VerticalAlignment="Center">
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Bitrate mín:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding MinBitrateMbps}" Width="45" TextAlignment="Center"/>
                                            <TextBlock Text="Mb/s" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldGroup}">
                                            <TextBlock Text="Tamaño mín:" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding MinSizeGB}" Width="45" TextAlignment="Center"/>
                                            <TextBlock Text="GB" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>
                                        <Button Content="▶ Buscar videos pesados" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" Margin="0,0,8,0"/>
                                        <Button Content="⏹ Detener" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelScanCommand}"/>
                                    </WrapPanel>
                                </Border>

                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar DockPanel.Dock="Top" Height="5" Value="{Binding ScanProgress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushWarning}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsText}" Foreground="{StaticResource BrushWarning}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <Border Grid.Row="2" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button Content="📂 Abrir en Explorador" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding SelectedHeavyItem.FilePath}" Margin="0,0,8,0"/>
                                            <Button Content="⚡ Enviar a Convertir / Comprimir" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SendToConverterCommand}" CommandParameter="{Binding SelectedHeavyItem.FilePath}" ToolTip="Abrir este video en la pestaña de Conversión"/>
                                        </WrapPanel>
                                        <ListView ItemsSource="{Binding HeavyItems}" SelectedItem="{Binding SelectedHeavyItem}" Background="Transparent" BorderThickness="0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Archivo" DisplayMemberBinding="{Binding FileName}" Width="190"/>
                                                    <GridViewColumn Header="Codec" DisplayMemberBinding="{Binding Codec}" Width="90"/>
                                                    <GridViewColumn Header="Bitrate" DisplayMemberBinding="{Binding BitrateFormatted}" Width="90"/>
                                                    <GridViewColumn Header="Resolución" DisplayMemberBinding="{Binding Resolution}" Width="90"/>
                                                    <GridViewColumn Header="Duración" DisplayMemberBinding="{Binding DurationFormatted}" Width="80"/>
                                                    <GridViewColumn Header="Tamaño" DisplayMemberBinding="{Binding SizeFormatted}" Width="85"/>
                                                    <GridViewColumn Header="Carpeta" DisplayMemberBinding="{Binding Directory}" Width="320"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ──────── 4. BUSCADOR DE DUPLICADOS ──────── -->
                        <TabItem Header="👥 Buscador de Duplicados" FontSize="12">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="8,6" Margin="0,0,0,6">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                            <CheckBox Content="Comparar 2 carpetas distintas (Carpeta A vs Carpeta B)" IsChecked="{Binding CompareTwoFolders}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <Button Content="▶ Buscar duplicados" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding StartScanCommand}" Margin="0,0,8,0"/>
                                            <Button Content="⏹ Detener" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelScanCommand}"/>
                                        </WrapPanel>
                                        <!-- Carpeta B si está activada la comparación -->
                                        <DockPanel Visibility="{Binding CompareTwoFolders, Converter={StaticResource BoolToVis}}" Margin="0,2,0,2">
                                            <TextBlock Text="Carpeta B:" Style="{StaticResource FieldLabel}" Margin="0,0,6,0"/>
                                            <Button DockPanel.Dock="Right" Content="Examinar..." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseFolderBCommand}"/>
                                            <TextBox Text="{Binding FolderPathB, UpdateSourceTrigger=PropertyChanged}" AllowDrop="True" DragOver="OnFolderBDragOver" Drop="OnFolderBDrop" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <ProgressBar DockPanel.Dock="Top" Height="5" Value="{Binding ScanProgress}" Maximum="100" Margin="0,0,0,4" Background="#21262D" Foreground="{StaticResource BrushAccent}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsText}" Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <Border Grid.Row="2" Background="#161B22" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button Content="📂 Abrir en Explorador" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding SelectedDuplicateItem.FilePath}" Margin="0,0,8,0"/>
                                            <Button Content="🗑 Enviar duplicado a Papelera" Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteDuplicateCommand}" CommandParameter="{Binding SelectedDuplicateItem}"/>
                                        </WrapPanel>
                                        <ListView ItemsSource="{Binding DuplicateItems}" SelectedItem="{Binding SelectedDuplicateItem}" Background="Transparent" BorderThickness="0">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="Grupo" DisplayMemberBinding="{Binding GroupId}" Width="55"/>
                                                    <GridViewColumn Header="Rol" DisplayMemberBinding="{Binding IsPrimary, Converter={x:Null}}" Width="95">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Copia duplicada"/>
                                                                            <Setter Property="Foreground" Value="#FFA198"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                                    <Setter Property="Text" Value="Original"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Archivo" DisplayMemberBinding="{Binding FileName}" Width="200"/>
                                                    <GridViewColumn Header="Tamaño" DisplayMemberBinding="{Binding SizeFormatted}" Width="85"/>
                                                    <GridViewColumn Header="Fecha modificado" DisplayMemberBinding="{Binding DateModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="120"/>
                                                    <GridViewColumn Header="Carpeta" DisplayMemberBinding="{Binding Directory}" Width="350"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
